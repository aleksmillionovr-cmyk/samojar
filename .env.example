# Скопируй этот файл в .env и заполни.
# Здесь только токены и секреты. Цены, тексты, ник поддержки, курс звезды
# и включение способов оплаты меняются в веб-админке.

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Твой Telegram ID (узнать: @userinfobot), сюда приходят заказы
ADMIN_ID=123456789

# ─── 🖥 Веб-админка ───
# Пароль для входа, минимум 8 символов (без него админка не запускается)
ADMIN_PASSWORD=
# 0.0.0.0 — открывать с любого устройства; 127.0.0.1 — только с этого компьютера
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8080
# Папка для заказов и каталога. На хостинге — постоянное хранилище (например /data), локально можно не трогать
DATA_DIR=
# Часовой пояс для дат в админке (МСК = 3)
TZ_OFFSET=3

# Валюта счетов картой
CURRENCY=RUB

# ─── 💳 Рубли картой ───
# Токен из @BotFather → /mybots → бот → Bot Settings → Payments (для теста — провайдер с пометкой TEST)
PROVIDER_TOKEN=

# ─── 💵 USDT (крипта) через @CryptoBot ───
# Токен приложения: @CryptoBot → Crypto Pay → Create App
# Для теста: @CryptoTestnetBot и CRYPTO_TESTNET=1 (тестовые монеты, реальные деньги не списываются)
CRYPTO_PAY_TOKEN=
CRYPTO_TESTNET=1
CRYPTO_ASSET=USDT

# Закрытый канал для подписчиков (бот должен быть там админом). Пусто — не используется.
# ID канала начинается с -100...
PRIVATE_CHANNEL_ID=
