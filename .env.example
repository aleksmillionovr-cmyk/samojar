# Файл .env создаёт install.sh. Здесь только то, что нужно для запуска.
# Токен бота, Telegram ID админов, ключи BoomKassa / CryptoBot / платёжки Telegram
# задаются в веб-админке → «Подключения» (сохраняются в data/config.json).

# Пароль входа в админку (минимум 8 символов). Потом можно сменить в админке → «Система»
ADMIN_PASSWORD=

# 127.0.0.1 — админка доступна только через Caddy (HTTPS); 0.0.0.0 — напрямую по http://IP:порт
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
# Админка стоит за Caddy/nginx (доверять X-Forwarded-For) и открывается только по https
TRUST_PROXY=1
COOKIE_SECURE=1
# Публичный адрес админки — из него получается адрес вебхука BoomKassa
PUBLIC_URL=https://45.158.185.31

# Папка для заказов, каталога и настроек
DATA_DIR=/opt/robux_bot/data
# Часовой пояс для дат в админке (МСК = 3)
TZ_OFFSET=3

# Необязательно: значения для первого запуска (потом их можно менять в админке)
# BOT_TOKEN=123456789:AAH...
# ADMIN_ID=123456789
# BOOMKASSA_API_KEY=bk_live_...
# BOOMKASSA_WEBHOOK_SECRET=...
